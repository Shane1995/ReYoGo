{
  "name": "@reyogo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../lib/config/oxlint.json src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "db:generate": "drizzle-kit generate",
    "db:push:local": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@reyogo/types": "workspace:*",
    "drizzle-orm": "0.36.0"
  },
  "devDependencies": {
    "@reyogo/config": "workspace:*",
    "@types/node": "^25.0.0",
    "drizzle-kit": "0.31.8",
    "oxlint": "^1.61.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
