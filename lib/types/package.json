    "lint": "oxlint --config ../../lib/config/oxlint.json src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/"
  },
  "devDependencies": {
    "oxlint": "^1.61.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
