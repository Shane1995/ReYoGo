{
  "name": "@reyogo/types",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./inventory": "./src/inventory/index.ts",
    "./invoices": "./src/invoices/index.ts",
    "./stockMovements": "./src/stockMovements/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
